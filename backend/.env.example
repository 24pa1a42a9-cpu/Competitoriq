# CompetitorIQ Backend Environment Configuration

# Flask Application Settings
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=competitoriq_dev_secret_key_change_in_production

# Database Configuration (SQLite)
# Default points to competitor_iq.db inside the backend directory
DATABASE_URL=sqlite:///competitor_iq.db

# Hindsight Memory System Configuration
# Real functional memory engine for persistent competitor tracking
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Groq LLM Configuration
# Recommended strategic reasoning model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
